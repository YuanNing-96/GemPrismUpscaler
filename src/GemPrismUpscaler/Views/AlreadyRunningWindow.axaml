<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GemPrismUpscaler.Views.AlreadyRunningWindow"
        Title="GemPrismUpscaler 已在运行"
        Width="540" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="GemPrismUpscaler 已在运行" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="MessageText" Margin="0,14,0,14"
                   TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13"/>
        <Button Grid.Row="2" x:Name="OkButton" Content="确定" HorizontalAlignment="Right" MinWidth="88"/>
    </Grid>
</Window>
