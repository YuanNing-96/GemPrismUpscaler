<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GemPrismUpscaler.Views.MainWindow"
        Title="宝石棱镜 GemPrismUpscaler"
        Width="1040" Height="800"
        MinWidth="880" MinHeight="660">
    <Grid Margin="14" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="宝石棱镜 · GemPrismUpscaler" FontSize="20" FontWeight="SemiBold"/>

        <Border Grid.Row="1" x:Name="ErrorBanner" IsVisible="False"
                Background="#FDECEA" BorderBrush="#E57373" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" x:Name="ErrorText" Foreground="#8B1E1E"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="ErrorLogButton" Content="查看日志" Margin="10,0,6,0"/>
                <Button Grid.Column="2" x:Name="ErrorCloseButton" Content="关闭"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="MainTabs" TabStripPlacement="Left" Margin="0,10,0,0">
            <TabItem Header="超分">
                <Grid Margin="10" RowDefinitions="Auto,*,Auto,Auto">
                    <StackPanel Grid.Row="0" Spacing="8">
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="超分算法" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="EffectCombo" SelectedIndex="0" MinWidth="300"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="输出显示器" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MonitorCombo" SelectedIndex="0" MinWidth="300"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="启动方式" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LaunchModeCombo" SelectedIndex="1" MinWidth="300">
                                <ComboBoxItem Content="已有游戏窗口"/>
                                <ComboBoxItem Content="嵌套启动"/>
                            </ComboBox>

                            <StackPanel Grid.Row="3" Grid.Column="0" x:Name="WindowBackendPanel" IsVisible="False">
                                <TextBlock Text="窗口类型" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="WindowBackendCombo" SelectedIndex="0"
                                      MinWidth="300" IsVisible="False">
                                <ComboBoxItem Content="X11 窗口"/>
                                <ComboBoxItem Content="Wayland 全屏窗口"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel IsVisible="False">
                            <Button x:Name="RefreshButton" Content="刷新窗口"/>
                            <Button x:Name="PortalButton" Content="Wayland 窗口…"/>
                            <Button x:Name="ExitButton" Content="退出"/>
                            <Button x:Name="NestedStartButton" Content="启动嵌套"/>
                            <CheckBox x:Name="StretchCheck"/>
                            <CheckBox x:Name="FollowFocusCheck" IsChecked="True"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <ListBox x:Name="WindowList"/>
                        <StackPanel x:Name="NestedPanel" IsVisible="False" Spacing="8">
                            <TextBlock Text="嵌套启动命令" FontWeight="SemiBold"/>
                            <TextBox x:Name="NestedCommandBox"
                                     PlaceholderText="env LUTRIS_SKIP_INIT=1 lutris lutris:rungameid/3"/>
                            <TextBlock x:Name="NestedHintText"
                                       Text="命令直接以 argv 启动（不经过 shell），支持引号。使用 Lutris 时请先关闭 Lutris，再在这里输入启动命令；v1.0 不支持自动注入环境变量。"
                                       Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="WaylandPanel" IsVisible="False" Spacing="8">
                            <TextBlock Text="Wayland 全屏窗口不处理输入，所以只支持 Wayland 全屏窗口：让鼠标输入直接穿透到画面下方的游戏窗口。"
                                       Foreground="#888" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,8">
                        <TextBlock x:Name="StatusText" Foreground="#888" Text="就绪"/>
                        <TextBlock x:Name="HotkeyHint" Text="热键：Alt+Shift+A（v1.0 暂不支持修改）"
                                   Foreground="#888" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StartButton" Content="开始超分"/>
                        <Button x:Name="StopButton" Content="停止超分" IsEnabled="False"/>
                        <Button x:Name="PauseButton" Content="暂停超分" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="12">
                        <TextBlock Text="常规" FontSize="15" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="显示/隐藏热键" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="HotkeyBox" IsReadOnly="True" Width="220"/>
                                <TextBlock Text="暂不支持修改" Foreground="#888" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="重复打开时的行为" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SecondInstanceCombo" MinWidth="260">
                                <ComboBoxItem Content="弹窗提示"/>
                                <ComboBoxItem Content="激活已有窗口"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="关闭窗口行为" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CloseActionCombo" MinWidth="260">
                                <ComboBoxItem Content="直接退出"/>
                                <ComboBoxItem Content="最小化到托盘"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="托盘" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="TrayEnabledCheck"
                                      Content="启用托盘" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="窗口列表刷新间隔" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="RefreshIntervalBox" Width="100"/>
                                <TextBlock Text="毫秒（自动刷新）" Foreground="#888" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="输入模式：视觉小说/2D 支持；FPS/鼠标视角暂不支持。"
                                   Foreground="#888" FontSize="12"/>

                        <TextBlock Text="日志" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="日志位置" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="LogPathBox" IsReadOnly="True" Width="480"/>
                                <Button x:Name="OpenLogButton" Content="打开日志目录"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel IsVisible="False">
                            <CheckBox x:Name="FollowFocusSettingCheck"/>
                            <CheckBox x:Name="RememberLastCheck"/>
                            <CheckBox x:Name="AutoRefreshCheck"/>
                            <ComboBox x:Name="DefaultMonitorCombo"/>
                            <ComboBox x:Name="DefaultEffectCombo"/>
                            <ComboBox x:Name="DefaultScalingCombo"/>
                            <CheckBox x:Name="DirtyRectCheck"/>
                            <CheckBox x:Name="DeveloperModeCheck"/>
                            <TextBlock x:Name="ValidationStatusText"/>
                            <TextBlock x:Name="TrayStatusText"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button x:Name="SaveSettingsButton" Content="保存设置"/>
                            <Button x:Name="ResetSettingsButton" Content="恢复默认"/>
                            <Button x:Name="OpenConfigDirButton" Content="打开配置目录"/>
                            <TextBlock x:Name="SettingsStatusText" Foreground="#888" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Profile" IsVisible="False">
                <Grid Margin="10" RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#666"
                               Text="Profile 来自 config.toml 的 [[profile]]，按文件顺序先匹配先赢。匹配 WM_CLASS、/proc/&lt;pid&gt;/exe 和 Wine cmdline 里的 .exe。"/>
                    <ListBox Grid.Row="1" x:Name="ProfileList" Margin="0,8"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="ReloadProfilesButton" Content="重新加载"/>
                        <Button x:Name="OpenProfileConfigButton" Content="打开 config.toml"/>
                        <TextBlock x:Name="ProfileStatusText" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="效果" IsVisible="False">
                <Grid Margin="10" RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#666"
                               Text="内置 Anime4K S/M/L/VL 与双线性。自定义 effect 放在配置目录的 effects/ 下，每个 effect 一个 TOML + 预编译 SPIR-V；详见 .doc/effects.md。"/>
                    <ListBox Grid.Row="1" x:Name="EffectList" Margin="0,8"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="ReloadEffectsButton" Content="重新加载"/>
                        <Button x:Name="OpenEffectsDirButton" Content="打开效果目录"/>
                        <TextBlock x:Name="EffectStatusText" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="日志" x:Name="LogTab">
                <Grid Margin="10" RowDefinitions="*,Auto">
                    <TextBox Grid.Row="0" x:Name="LogText" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontSize="12"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="LogTabOpenButton" Content="打开日志目录"/>
                        <Button x:Name="ExportDiagnosticsButton" Content="导出诊断包"/>
                        <Button x:Name="LogTabClearButton" Content="清空显示"/>
                        <TextBlock x:Name="LogTabStatusText" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
