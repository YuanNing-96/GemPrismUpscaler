<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GemPrismUpscaler.Views.MainWindow"
        Title="宝石棱镜 GemPrismUpscaler"
        Width="860" Height="620"
        MinWidth="640" MinHeight="480">
    <Grid Margin="14" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" Text="宝石棱镜 · GemPrismUpscaler" FontSize="20" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,6">
            <Button x:Name="RefreshButton" Content="刷新窗口"/>
            <CheckBox x:Name="StretchCheck" Content="拉伸填满（默认保持比例）" VerticalAlignment="Center"/>
            <CheckBox x:Name="FollowFocusCheck" Content="跟随焦点（切到其他程序时收起）" IsChecked="True" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666" Text="就绪"/>
        </StackPanel>
        <ListBox Grid.Row="2" x:Name="WindowList" Margin="0,4"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8">
            <Button x:Name="StartButton" Content="开始超分"/>
            <Button x:Name="StopButton" Content="停止" IsEnabled="False"/>
            <Button x:Name="ExitButton" Content="退出"/>
            <TextBlock Text="热键：Alt+Shift+A 显示/隐藏覆盖层" VerticalAlignment="Center" Foreground="#666" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBox Grid.Row="4" x:Name="LogText" Height="150" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" Margin="0,6,0,0" FontSize="11"/>
    </Grid>
</Window>
