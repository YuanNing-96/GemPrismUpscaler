<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GemPrismUpscaler.Core</RootNamespace>
    <AssemblyName>GemPrismUpscaler.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="NWayland" Version="0.11.0" />
    <PackageReference Include="NWayland.Protocols.Wlr" Version="0.11.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders/*.spv" />
    <EmbeddedResource Include="Shaders/*.json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GemPrismUpscaler.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>